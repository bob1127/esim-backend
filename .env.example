# ── Railway 必填 ──
PORT=9000
NODE_ENV=production

# ── 資料庫 ──
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── 公開網址（填 Vercel 代理網域，不是 Railway 網址）──
MEDUSA_BACKEND_URL=https://esim-backend-66ch.vercel.app

# ── 開啟正式環境 Admin 後台（給非工程師新增商品用）──
MEDUSA_ADMIN_ENABLE=true

# ── CORS ──
STORE_CORS=http://localhost:3000,https://e-sim-pwa-3k6n.vercel.app
ADMIN_CORS=http://localhost:9000,https://esim-backend-66ch.vercel.app
AUTH_CORS=http://localhost:3000,https://e-sim-pwa-3k6n.vercel.app,https://esim-backend-66ch.vercel.app

# ── 安全金鑰（production 請換成隨機字串）──
JWT_SECRET=supersecret-change-me
COOKIE_SECRET=supersecret-change-me

# ── 後台網址（給團隊）──
# https://esim-backend-66ch.vercel.app/app
