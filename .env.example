# ── Railway 必填 ──
PORT=9000
NODE_ENV=production

# ── 資料庫 ──
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── 公開網址（填 Vercel 代理網域；未設定時圖片 URL 會存成 localhost，前台無法顯示）──
MEDUSA_BACKEND_URL=https://jeko-backend.vercel.app

# ── 開啟正式環境 Admin 後台（給非工程師新增商品用）──
MEDUSA_ADMIN_ENABLE=true

# ── CORS ──
STORE_CORS=http://localhost:3000,https://jeko-e-sim.vercel.app
ADMIN_CORS=http://localhost:9000,https://jeko-backend.vercel.app
AUTH_CORS=http://localhost:3000,https://jeko-e-sim.vercel.app,https://jeko-backend.vercel.app

# ── 安全金鑰（production 請換成隨機字串）──
JWT_SECRET=supersecret-change-me
COOKIE_SECRET=supersecret-change-me

# ── 後台網址（給團隊）──
# https://jeko-backend.vercel.app/app

# ── 商品介紹內部 API（與 esim-store-front 相同密鑰）──
PRODUCT_CONTENT_ADMIN_SECRET=your-long-random-secret-min-16-chars

# ── 夥伴管理 iframe（Medusa Admin 側欄「夥伴管理」）──
VITE_JEKO_PARTNER_DASHBOARD_URL=https://www.jeko-esim.com.tw/admin-boss?embed=1
JEKO_PARTNER_DASHBOARD_URL=https://www.jeko-esim.com.tw/admin-boss?embed=1

# ── 藍新金流 NewebPay MPG（結帳、背景通知、eSIM 發貨都在這個後端處理）──
NEWEBPAY_MERCHANT_ID=your-newebpay-merchant-id
NEWEBPAY_HASH_KEY=your-newebpay-hash-key
NEWEBPAY_HASH_IV=your-newebpay-hash-iv
# production 用正式機，其餘（含未設定）用測試機
NEWEBPAY_ENV=production
NEWEBPAY_ALLOWED_METHODS=CREDIT,VACC,WEBATM

# ── LINE Pay Online API v4（正式）────────────────────────────
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_API_BASE=https://api-pay.line.me

# ── 前台網域（ClientBackURL / linepay-confirm redirectUrl）──
STORE_URL=https://www.jeko-esim.com.tw

# ── esim-store-front 的既有 eSIM 發貨 / 寄信 / 發票 API ──
# secret 必須與 esim-store-front 的 FULFILLMENT_INTERNAL_SECRET 相同
FULFILLMENT_INTERNAL_URL=https://www.jeko-esim.com.tw
FULFILLMENT_INTERNAL_SECRET=your-long-random-secret-min-16-chars

# ── 後台新增/修改商品 → 立刻清前台 ISR（subscriber: revalidate-storefront）──
# 未設 REVALIDATE_SECRET 時會沿用 FULFILLMENT_INTERNAL_SECRET
# REVALIDATE_SECRET=your-long-random-secret-min-16-chars
# 未設 STOREFRONT_REVALIDATE_URL 時依序用 FULFILLMENT_INTERNAL_URL → STORE_URL
# STOREFRONT_REVALIDATE_URL=https://www.jeko-esim.com.tw

# ── Cloudflare R2（商品圖上傳；需 medusa file-s3）──
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=jeko-esim
S3_REGION=auto
S3_FILE_URL=https://pub-xxxx.r2.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 可選：物件前綴，例如 products/
# S3_PREFIX=
