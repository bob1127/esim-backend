{
  "installCommand": "echo skip",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/newebpay/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/newebpay/:path*"
    },
    {
      "source": "/linepay/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/linepay/:path*"
    },
    {
      "source": "/tappay/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/tappay/:path*"
    },
    {
      "source": "/store/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/store/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/admin/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/app/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/uploads/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://esim-backend-production-f90c.up.railway.app/static/:path*"
    },
    {
      "source": "/health",
      "destination": "https://esim-backend-production-f90c.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
